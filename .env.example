# Copy to .env and fill in real values. Never commit .env.

# Azure OpenAI
# Endpoint must end in /openai/v1 (Cognitive Services resource, not the Foundry project endpoint).
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
AZURE_OPENAI_KEY=<your-key>
AZURE_OPENAI_CHAT_DEPLOYMENT=<your-gpt-4.1-mini-deployment-name>
AZURE_OPENAI_EMBED_DEPLOYMENT=<your-text-embedding-3-small-deployment-name>

# Azure DevOps
AZURE_DEVOPS_ORG=omwani
AZURE_DEVOPS_PROJECT=devops-pilot-test
AZURE_DEVOPS_PAT=<your-token>
AZURE_DEVOPS_API_BASE_URL=https://dev.azure.com
